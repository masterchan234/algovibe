# =============================================================================
# ALGOVIBE — Environment Variables Example
# Salin file ini ke .env lalu isi nilai yang sesuai.
# JANGAN commit file .env ke version control.
# =============================================================================

# =============================================================================
# 1. INDODAX API CREDENTIALS (WAJIB)
#    Dapatkan di: https://indodax.com/api-management
# =============================================================================
INDODAX_API_KEY=your_indodax_api_key_here
INDODAX_API_SECRET=your_indodax_api_secret_here

# =============================================================================
# 2. TELEGRAM NOTIFICATIONS (Opsional — kosongkan jika tidak dipakai)
#    Token: https://t.me/BotFather
#    Chat ID: https://t.me/userinfobot
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# 3. DASHBOARD SECURITY (WAJIB untuk production)
#    SECRET_KEY : kunci enkripsi sesi Flask — gunakan string acak panjang (32+ karakter)
#    WS_SALT    : salt untuk handshake WebSocket — ubah dari nilai default
# =============================================================================
SECRET_KEY=change-me-to-a-long-random-string-in-production
WS_SALT=algovibe_salt_2024

# =============================================================================
# 4. MARKET HUB — Mode SaaS/Multi-Bot (Opsional)
#    USE_MARKET_HUB : set "true" jika menjalankan market_hub.py sebagai sumber data
#    MARKET_HUB_HOST: host ZMQ publisher (default: 127.0.0.1)
#    MARKET_HUB_PORT: port ZMQ publisher (default: 5555)
# =============================================================================
USE_MARKET_HUB=false
MARKET_HUB_HOST=127.0.0.1
MARKET_HUB_PORT=5555

# =============================================================================
# 5. LOGGING (Opsional — nilai default sudah aman)
#    ENABLE_FILE_LOGGING : "true" / "false"
#    LOG_MAX_BYTES       : ukuran maksimal satu file log (default: 10485760 = 10 MB)
#    LOG_BACKUP_COUNT    : jumlah rotasi file log disimpan (default: 5)
# =============================================================================
ENABLE_FILE_LOGGING=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# 6. TRADING PARAMETERS (Opsional — override nilai dari config.py)
#    MIN_TRADE_IDR : nilai order minimum dalam IDR (default: 10500)
# =============================================================================
MIN_TRADE_IDR=10500

# =============================================================================
# 7. PATHS (Opsional — hanya perlu diisi jika direktori kerja bukan root repo)
#    APP_BASE_PATH : path absolut ke direktori root aplikasi
# =============================================================================
# APP_BASE_PATH=/app

# =============================================================================
# 8. DOCKER / REGISTRY (Dipakai oleh docker-compose.yml dan build scripts)
#    REGISTRY_IP : IP/hostname private Docker registry
# =============================================================================
# REGISTRY_IP=80.241.217.181

# =============================================================================
# 9. LITERT-LM EXIT DECISION SERVICE (Opsional)
# =============================================================================
# LLM_EXIT_INTERVAL_SEC=20
# LLM_EXIT_COOLDOWN_SEC=45
# LLM_EXIT_MIN_CONFIDENCE=80
# LLM_EXIT_MAX_PAIRS=4
# LLM_SCAN_INTERVAL_SEC=30
# LLM_SCAN_MAX_PAIRS=5
# LLM_SCAN_MIN_CONFIDENCE=75
# LLM_SCAN_MIN_VOL_IDR=1000000
